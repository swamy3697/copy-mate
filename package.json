{
  "name": "copy-mate",
  "displayName": "Copy Mate",
  "description": "Copy code from multiple files with file locations by a single click.",
  "version": "1.0.0",
  "publisher": "SwamyPenupothula",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/swamy3697/copy-mate.git"
  },
  "license": "MIT",
  "contributes": {
    "commands": [
      {
        "command": "copy-mate",
        "title": "Copy Mate"
      },
      {
        "command": "copy-mate.copyFileOrFolder",
        "title": "Copy Structure and Content",
        "category": "Copy Mate"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "copy-mate.copyFileOrFolder",
          "when": "resourceScheme == file",
          "group": "copy"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/sinon": "^17.0.3",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.16.0",
    "sinon": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
